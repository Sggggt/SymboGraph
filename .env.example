APP_NAME=KnowledgeBase Knowledge Base API
APP_ENV=development
APP_PORT=8000
API_IMAGE=course-kg-api:local
WEB_IMAGE=course-kg-web:local
INGESTION_TASK_QUEUE=course-kg-main-ingestion

# Docker Compose host ports.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Infrastructure.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/symbograph
ENABLE_DATABASE_FALLBACK=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=

# Knowledge base storage.
KNOWLEDGE_BASE_NAME=Sample KnowledgeBase
DATA_ROOT=./data
# STORAGE_ROOT=./data/Sample KnowledgeBase/storage
# INGESTION_ROOT=./data/Sample KnowledgeBase/ingestion

# Local model bridge.
MODEL_BRIDGE_ENABLED=true
MODEL_BRIDGE_PORT=8765

# Chat model.
OPENAI_API_KEY=
CHAT_BASE_URL=
CHAT_RESOLVE_IP=
CHAT_MODEL=qwen-plus

# Embedding model. EMBEDDING_BASE_URL is required for real embedding calls and never falls back to CHAT_BASE_URL.
EMBEDDING_BASE_URL=
EMBEDDING_RESOLVE_IP=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSIONS=1024

# Bounded runtime concurrency.
WORKER_CONCURRENCY=3
INGESTION_FILE_CONCURRENCY=3
MODEL_REQUEST_CONCURRENCY=3
MODEL_REQUEST_TIMEOUT_SECONDS=240

# Evidence graph and active chunk policy.
CHUNK_TOKEN_BUDGET=2400
ENABLE_GRAPH_COMMUNITY_SUMMARIES=true
SIGNAL_EXTRACTION_MAX_MODEL_BATCHES=4
SIGNAL_EXTRACTION_MAX_CANDIDATES_PER_BATCH=40
SIGNAL_EXTRACTION_MAX_TOKENS_PER_BATCH=6000
SIGNAL_CANDIDATE_KEEP_THRESHOLD=0.62
COMMUNITY_LOUVAIN_RESOLUTION=1.0
COMMUNITY_MIN_MODULARITY_WARN=0.18
GRAPH_OVERVIEW_MAX_NODES=260
GRAPH_OVERVIEW_MAX_EDGES=800

# Fallbacks are disabled on the active product path.
ENABLE_MODEL_FALLBACK=false

# Chunk and rerank enhancement.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=cpu

# HuggingFace Hub offline mode avoids network retries on startup when the model is already cached.
HF_HUB_OFFLINE=1

# Semantic chunk candidate generation.
SEMANTIC_CHUNKING_ENABLED=false
SEMANTIC_CHUNKING_MIN_LENGTH=2000

# Retrieval and answer quality runtime controls.
RETRIEVAL_LAYER_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=120
ENABLE_AGENTIC_REFLECTION=true
ENABLE_POST_GENERATION_REFLECTION=false
CITATION_VERIFICATION_SAMPLE_MAX=3
REFLECTION_MAX_RETRIES=2
