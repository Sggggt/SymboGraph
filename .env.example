APP_NAME=KnowledgeBase Knowledge Base API
APP_ENV=development
APP_PORT=8000
# Runtime image refs. Digest-qualified refs are valid only with start-app.ps1
# -SkipBuild; rebuild-images.ps1 always uses its explicit mutable build tags.
API_IMAGE=course-kg-api:local
WEB_IMAGE=course-kg-web:local
INGESTION_TASK_QUEUE=course-kg-main-ingestion

# Docker Compose host ports.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Infrastructure.
POSTGRES_USER=symbograph
POSTGRES_PASSWORD=
POSTGRES_DB=symbograph
DATABASE_URL=
ENABLE_DATABASE_FALLBACK=false
# Comma-separated exact Alembic revisions; leave empty except for a reviewed one-shot destructive upgrade.
ALLOW_DESTRUCTIVE_MIGRATIONS=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=

# Knowledge base storage.
KNOWLEDGE_BASE_NAME=Sample KnowledgeBase
DATA_ROOT=./data
# Docker Compose resolves this host bind path relative to infra/docker-compose.yml.
# Keep it raw-only and operator-prepared; never point it at mutable application DATA_ROOT.
SAMPLE_IMPORT_PATH=./sample-import
SAMPLE_IMPORT_ROOT=./infra/sample-import
SAMPLE_IMPORT_MANIFEST=./infra/sample-import/raw-manifest.json
UPLOAD_MAX_BYTES=104857600
# STORAGE_ROOT=./data/Sample KnowledgeBase/storage
# INGESTION_ROOT=./data/Sample KnowledgeBase/ingestion

# Local model bridge.
MODEL_BRIDGE_ENABLED=true
MODEL_BRIDGE_PORT=8765
MODEL_BRIDGE_ADMIN_TOKEN=

# Dialogue model. openai appends /chat/completions; anthropic appends
# /v1/messages, so an Anthropic base must not already end in /v1.
CHAT_API_KEY=
CHAT_API_PROTOCOL=openai
CHAT_BASE_URL=
CHAT_RESOLVE_IP=
CHAT_MODEL=

# Graph build model. Uses the same closed protocol/base rules as chat.
GRAPH_API_KEY=
GRAPH_API_PROTOCOL=openai
GRAPH_BASE_URL=
GRAPH_RESOLVE_IP=
GRAPH_MODEL=

# Embedding model. EMBEDDING_BASE_URL is required for real embedding calls and never falls back to CHAT_BASE_URL.
EMBEDDING_API_PROTOCOL=openai
EMBEDDING_BASE_URL=
EMBEDDING_RESOLVE_IP=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSIONS=1024

# Bounded runtime concurrency.
WORKER_CONCURRENCY=3
WORKER_MAX_TASKS_PER_CHILD=1
MODEL_REQUEST_CONCURRENCY=2
MODEL_REQUEST_TIMEOUT_SECONDS=240
CHAT_JSON_MAX_TOKENS=12000
AGENT_REQUEST_CONCURRENCY=4
SOURCE_IO_CONCURRENCY=4
AGENT_REQUEST_QUEUE_LIMIT=8
AGENT_REQUEST_QUEUE_TIMEOUT_SECONDS=30
AGENT_REQUEST_LEASE_TTL_SECONDS=300
CONCEPT_I18N_ENABLED=false
QUERY_FACET_BILINGUAL_ENABLED=false
QUERY_FACET_POSTERIOR_ENABLED=true
QUERY_FACET_POSTERIOR_OBSERVATION_BUDGET=64
QUERY_FACET_POSTERIOR_ROUND_BUDGET=2
QUERY_FACET_POSTERIOR_CONVERGENCE_EPSILON=0.02
INGESTION_MEMORY_SOFT_LIMIT_RATIO=0.78
INGESTION_MEMORY_HARD_LIMIT_RATIO=0.88
INGESTION_MEMORY_CRITICAL_LIMIT_RATIO=0.94

# Four-layer context graph and chunk relation policy.
FIXED_CHUNK_SIZE_TOKENS=512
FIXED_CHUNK_OVERLAP_TOKENS=80
CONTEXT_PACKAGE_TOKEN_BUDGET=15000
RETRIEVAL_RESULT_TOP_K_DEFAULT=12
MID_CONCEPT_EXTRACTION_MAX_MODEL_BATCHES=4
MID_CONCEPT_EXTRACTION_MAX_CANDIDATES_PER_BATCH=8
MID_CONCEPT_EXTRACTION_MAX_TOKENS_PER_BATCH=2400
MID_CONCEPT_CANDIDATE_KEEP_THRESHOLD=0.62
RQ_KMEANS_LEVELS=3
RQ_KMEANS_MAX_K=6
RQ_RESIDUAL_TAU=0.65
EDGE_DISTANCE_PROTOCOL=edge_distance_log_calibrated_strength_v2
RQ_MEMBERSHIP_PROTOCOL=rq_fuzzy_softmax_gamma_product_v1
EDGE_PROJECTION_PROTOCOL=membership_q15_layer_type_calibrated_v3
EDGE_TYPE_CALIBRATION_PROTOCOL=type_local_winsorized_minmax_v1
RQ_MEMBERSHIP_TEMPERATURE=0.35
RQ_MEMBERSHIP_TOP_M=2
RQ_MEMBERSHIP_PROBABILITY_THRESHOLD=0.05
DENSE_KNN_K_MIN=5
DENSE_KNN_K_MAX=24
DENSE_REVERSE_B_MIN_BASE=2
DENSE_REVERSE_B_MAX_BASE=8
DENSE_REVERSE_B_MIN_DOC=1
DENSE_REVERSE_B_MAX_DOC=6
DENSE_REVERSE_B_MIN_LANG=1
DENSE_REVERSE_B_MAX_LANG=4
DENSE_MIN_COSINE=0.58
DENSE_STRONG_COSINE=0.72
CROSS_DOC_OUT_QUOTA_MIN=1
CROSS_DOC_OUT_QUOTA_MAX=4
CROSS_DOC_MIN_COSINE=0.62
CROSS_LANGUAGE_OUT_QUOTA_MIN=0
CROSS_LANGUAGE_OUT_QUOTA_MAX=3
CROSS_LANGUAGE_MIN_COSINE=0.65
ENABLE_AUTO_TPE=false
TPE_TRIAL_BUDGET=6
TPE_STARTUP_RANDOM_TRIALS=3
TPE_GOOD_QUANTILE_GAMMA=0.25
TPE_PROBE_QUERY_BUDGET=6
TPE_TRIAL_TIMEOUT_SECONDS=600
TPE_CANDIDATE_POOL_SIZE=24
OPERATING_POINT_HARD_GATE_MAX_EDGE_DENSITY=0.45
OPERATING_POINT_HARD_GATE_MAX_ISOLATED_RATIO=0.35
OPERATING_POINT_HARD_GATE_MAX_HUBNESS_RATIO=12.0
OPERATING_POINT_HARD_GATE_MIN_STRUCTURE_RECOVERY_RATE=0.25
OPERATING_POINT_HARD_GATE_MAX_CANDIDATE_LATENCY_P95_MS=600000
AGENT_COARSE_INITIAL_BUDGET=3
AGENT_COARSE_TOP_K=5
# Legacy alias: AGENT_COARSE_TOTAL_BUDGET falls back to AGENT_COARSE_INITIAL_BUDGET when the new key is absent.
AGENT_COARSE_TOTAL_BUDGET=3
AGENT_MID_PER_COARSE_BUDGET=2
AGENT_COARSE_DRILLDOWN_MID_INITIAL_BUDGET=8
AGENT_MID_INITIAL_BUDGET=5
AGENT_MID_TOP_K=10
AGENT_CHUNK_PER_MID_BUDGET=3
AGENT_CHUNK_INITIAL_BUDGET=8
AGENT_CHUNK_TOP_K=12
CANDIDATE_POOL_DEDUPE_BUDGET=80
AGENT_MAX_DEPTH_PER_LAYER=3
AGENT_MAX_LABELS_PER_NODE=3
AGENT_MAX_EDGE_REUSE=2
AGENT_MAX_CYCLE_REWARD_PER_PATH=0.18
AGENT_CYCLE_REWARD_DISTANCE_THRESHOLD=1.2
AGENT_PATH_DISTANCE_GREEN_THRESHOLD=0.45
AGENT_PATH_DISTANCE_GRAY_THRESHOLD=1.35
AGENT_PATH_DISTANCE_HARD_THRESHOLD=2.4
GRAY_ZONE_RULE_PROTOCOL=deterministic_support_progress_v1
GRAY_ZONE_OBSERVATION_CADENCE=1
# Traversal-wide cap on persisted expanded gray-zone observations; local rule evaluation still runs after exhaustion.
TRAVERSAL_OBSERVATION_BUDGET=64
AGENT_STRUCTURE_RESTORE_PER_CHUNK_BUDGET=2
# Legacy alias: AGENT_STRUCTURE_RESTORE_BUDGET falls back to AGENT_STRUCTURE_RESTORE_PER_CHUNK_BUDGET when the new key is absent.
AGENT_STRUCTURE_RESTORE_BUDGET=2
CONTEXT_PATH_SUMMARY_BUDGET=32
AGENT_PLANNING_ROUND_BUDGET=2
AGENT_MAX_TYPED_ACTIONS_PER_ROUND=8
AGENT_REPAIR_ROUND_BUDGET=2
AGENT_VERIFICATION_BUDGET=8

# Fallbacks are disabled on the active product path.
ENABLE_MODEL_FALLBACK=false
