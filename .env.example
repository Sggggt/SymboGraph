APP_NAME=KnowledgeBase Knowledge Base API
APP_ENV=development
APP_PORT=8000
# Runtime image refs. Digest-qualified refs are valid only with start-app.ps1
# -SkipBuild; rebuild-images.ps1 always uses its explicit mutable build tags.
API_IMAGE=course-kg-api:local
INGESTION_TASK_QUEUE=course-kg-main-ingestion

# Docker Compose host ports.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Infrastructure.
POSTGRES_USER=symbograph
POSTGRES_PASSWORD=
POSTGRES_DB=symbograph
DATABASE_URL=
ENABLE_DATABASE_FALLBACK=false
# Comma-separated exact Alembic revisions; leave empty except for a reviewed one-shot destructive upgrade.
ALLOW_DESTRUCTIVE_MIGRATIONS=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=

# Knowledge base storage.
KNOWLEDGE_BASE_NAME=Sample KnowledgeBase
DATA_ROOT=./data
# STORAGE_ROOT=./data/Sample KnowledgeBase/storage
# INGESTION_ROOT=./data/Sample KnowledgeBase/ingestion

# Local model bridge.
MODEL_BRIDGE_ENABLED=true
MODEL_BRIDGE_PORT=8765
MODEL_BRIDGE_ADMIN_TOKEN=

# Dialogue model. openai appends /chat/completions; anthropic appends
# /v1/messages, so an Anthropic base must not already end in /v1.
CHAT_API_KEY=
CHAT_API_PROTOCOL=openai
CHAT_BASE_URL=
CHAT_RESOLVE_IP=
CHAT_MODEL=

# Graph build model. Uses the same closed protocol/base rules as chat.
GRAPH_API_KEY=
GRAPH_API_PROTOCOL=openai
GRAPH_BASE_URL=
GRAPH_RESOLVE_IP=
GRAPH_MODEL=

# Embedding model. EMBEDDING_BASE_URL is required for real embedding calls and never falls back to CHAT_BASE_URL.
EMBEDDING_API_PROTOCOL=openai
EMBEDDING_BASE_URL=
EMBEDDING_RESOLVE_IP=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# Process and service shape. Non-secret runtime and graph parameters live in
# settings.json; the tracked defaults are in settings.example.json.
WORKER_CONCURRENCY=3
WORKER_MAX_TASKS_PER_CHILD=1

# Fallbacks are disabled on the active product path.
ENABLE_MODEL_FALLBACK=false
