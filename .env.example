APP_NAME=KnowledgeBase Knowledge Base API
APP_ENV=development
APP_PORT=8000
API_IMAGE=course-kg-api:local
WEB_IMAGE=course-kg-web:local
INGESTION_TASK_QUEUE=course-kg-main-ingestion

# Docker Compose host ports.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Infrastructure.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/symbograph
ENABLE_DATABASE_FALLBACK=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=

# Knowledge base storage.
KNOWLEDGE_BASE_NAME=Sample KnowledgeBase
DATA_ROOT=./data
# STORAGE_ROOT=./data/Sample KnowledgeBase/storage
# INGESTION_ROOT=./data/Sample KnowledgeBase/ingestion

# Local model bridge.
MODEL_BRIDGE_ENABLED=true
MODEL_BRIDGE_PORT=8765
MODEL_BRIDGE_ADMIN_TOKEN=

# Dialogue model.
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_RESOLVE_IP=
CHAT_MODEL=qwen-plus

# Graph build model.
GRAPH_API_KEY=
GRAPH_BASE_URL=
GRAPH_RESOLVE_IP=
GRAPH_MODEL=qwen-plus

# Embedding model. EMBEDDING_BASE_URL is required for real embedding calls and never falls back to CHAT_BASE_URL.
EMBEDDING_BASE_URL=
EMBEDDING_RESOLVE_IP=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSIONS=1024

# Bounded runtime concurrency.
WORKER_CONCURRENCY=3
WORKER_MAX_TASKS_PER_CHILD=1
MODEL_REQUEST_CONCURRENCY=2
MODEL_REQUEST_TIMEOUT_SECONDS=240
CONCEPT_I18N_ENABLED=false
QUERY_FACET_BILINGUAL_ENABLED=false
INGESTION_MEMORY_SOFT_LIMIT_RATIO=0.78
INGESTION_MEMORY_HARD_LIMIT_RATIO=0.88
INGESTION_MEMORY_CRITICAL_LIMIT_RATIO=0.94

# Four-layer context graph and chunk relation policy.
FIXED_CHUNK_SIZE_TOKENS=512
FIXED_CHUNK_OVERLAP_TOKENS=80
CONTEXT_PACKAGE_TOKEN_BUDGET=6000
MID_CONCEPT_EXTRACTION_MAX_MODEL_BATCHES=4
MID_CONCEPT_EXTRACTION_MAX_CANDIDATES_PER_BATCH=8
MID_CONCEPT_EXTRACTION_MAX_TOKENS_PER_BATCH=2400
MID_CONCEPT_CANDIDATE_KEEP_THRESHOLD=0.62
RQ_KMEANS_LEVELS=3
RQ_KMEANS_MAX_K=6
RQ_RESIDUAL_TAU=0.65
DENSE_KNN_K_MIN=5
DENSE_KNN_K_MAX=24
DENSE_REVERSE_B_MIN_BASE=2
DENSE_REVERSE_B_MAX_BASE=8
DENSE_REVERSE_B_MIN_DOC=1
DENSE_REVERSE_B_MAX_DOC=6
DENSE_REVERSE_B_MIN_LANG=1
DENSE_REVERSE_B_MAX_LANG=4
DENSE_MIN_COSINE=0.58
DENSE_STRONG_COSINE=0.72
CROSS_DOC_OUT_QUOTA_MIN=1
CROSS_DOC_OUT_QUOTA_MAX=4
CROSS_DOC_MIN_COSINE=0.62
CROSS_LANGUAGE_OUT_QUOTA_MIN=0
CROSS_LANGUAGE_OUT_QUOTA_MAX=3
CROSS_LANGUAGE_MIN_COSINE=0.65
ENABLE_AUTO_TPE=false
TPE_TRIAL_BUDGET=6
TPE_STARTUP_RANDOM_TRIALS=3
TPE_GOOD_QUANTILE_GAMMA=0.25
TPE_PROBE_QUERY_BUDGET=6
TPE_TRIAL_TIMEOUT_SECONDS=600
TPE_CANDIDATE_POOL_SIZE=24
OPERATING_POINT_HARD_GATE_MAX_EDGE_DENSITY=24.0
OPERATING_POINT_HARD_GATE_MAX_ISOLATED_RATIO=0.35
OPERATING_POINT_HARD_GATE_MAX_HUBNESS_RATIO=12.0
OPERATING_POINT_HARD_GATE_MIN_STRUCTURE_RECOVERY_RATE=0.25
OPERATING_POINT_HARD_GATE_MAX_CANDIDATE_LATENCY_P95_MS=600000
AGENT_COARSE_TOTAL_BUDGET=8
AGENT_MID_PER_COARSE_BUDGET=8
AGENT_MID_TOP_K=16
AGENT_CHUNK_PER_MID_BUDGET=16
AGENT_CHUNK_TOP_K=40
CANDIDATE_POOL_DEDUPE_BUDGET=160
AGENT_MAX_DEPTH_PER_LAYER=3
AGENT_MAX_LABELS_PER_NODE=3
AGENT_MAX_EDGE_REUSE=2
AGENT_MAX_CYCLE_REWARD_PER_PATH=0.18
AGENT_CYCLE_REWARD_DISTANCE_THRESHOLD=1.2
AGENT_PATH_DISTANCE_GREEN_THRESHOLD=0.45
AGENT_PATH_DISTANCE_GRAY_THRESHOLD=1.35
AGENT_PATH_DISTANCE_HARD_THRESHOLD=2.4
AGENT_STRUCTURE_RESTORE_BUDGET=16
CONTEXT_PATH_SUMMARY_BUDGET=32
AGENT_PLANNING_ROUND_BUDGET=2
AGENT_MAX_TYPED_ACTIONS_PER_ROUND=8
AGENT_REPAIR_ROUND_BUDGET=2
AGENT_VERIFICATION_BUDGET=8

# Fallbacks are disabled on the active product path.
ENABLE_MODEL_FALLBACK=false
