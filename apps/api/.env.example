APP_NAME=KnowledgeBase Knowledge Base API
APP_ENV=development
APP_PORT=8000

INGESTION_TASK_QUEUE=course-kg-main-ingestion

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/symbograph
ENABLE_DATABASE_FALLBACK=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=

KNOWLEDGE_BASE_NAME=Sample KnowledgeBase
DATA_ROOT=./data
# STORAGE_ROOT=./data/Sample KnowledgeBase/storage
# INGESTION_ROOT=./data/Sample KnowledgeBase/ingestion

MODEL_BRIDGE_ENABLED=true
MODEL_BRIDGE_PORT=8765
MODEL_BRIDGE_ADMIN_TOKEN=

OPENAI_API_KEY=
CHAT_BASE_URL=
CHAT_RESOLVE_IP=
CHAT_MODEL=qwen-plus

EMBEDDING_BASE_URL=
EMBEDDING_RESOLVE_IP=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSIONS=1024

WORKER_CONCURRENCY=3
MODEL_REQUEST_CONCURRENCY=3
MODEL_REQUEST_TIMEOUT_SECONDS=240

FIXED_CHUNK_SIZE_TOKENS=512
FIXED_CHUNK_OVERLAP_TOKENS=80
CONTEXT_PACKAGE_TOKEN_BUDGET=2400
MID_CONCEPT_EXTRACTION_MAX_MODEL_BATCHES=4
MID_CONCEPT_EXTRACTION_MAX_CANDIDATES_PER_BATCH=8
MID_CONCEPT_EXTRACTION_MAX_TOKENS_PER_BATCH=2400
MID_CONCEPT_CANDIDATE_KEEP_THRESHOLD=0.62
RQ_KMEANS_LEVELS=3
RQ_KMEANS_MAX_K=6
RQ_RESIDUAL_TAU=0.65
AGENT_COARSE_ENTRY_BUDGET=8
AGENT_COARSE_JUMP_BUDGET=2
AGENT_MID_ENTRY_BUDGET=16
AGENT_MID_EXPANSION_RADIUS_CAP=2
AGENT_FINE_ENTRY_BUDGET=16
AGENT_FRONTIER_EXPANSION_BUDGET=80
AGENT_MAX_DEPTH_PER_LAYER=3
AGENT_MAX_LABELS_PER_NODE=3
AGENT_MAX_EDGE_REUSE=2
AGENT_MAX_CYCLE_REWARD_PER_PATH=0.18
AGENT_AMBIGUOUS_EDGE_DISTANCE_LOW=0.45
AGENT_AMBIGUOUS_EDGE_DISTANCE_HIGH=1.35
AGENT_DRILLDOWN_BUDGET_PER_LAYER=16
AGENT_CHUNK_CANDIDATE_BUDGET=80
AGENT_STRUCTURE_RESTORE_BUDGET=16
CONTEXT_PATH_SUMMARY_BUDGET=32
AGENT_PLANNING_ROUND_BUDGET=2
AGENT_MAX_TYPED_ACTIONS_PER_ROUND=8
AGENT_REPAIR_ROUND_BUDGET=2
AGENT_VERIFICATION_BUDGET=8
ENABLE_MODEL_FALLBACK=false

RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=cpu
HF_HUB_OFFLINE=1
