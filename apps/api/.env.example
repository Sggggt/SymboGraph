APP_NAME=Course Knowledge Base API
APP_ENV=development
APP_PORT=8000
MODEL_BRIDGE_ENABLED=true
MODEL_BRIDGE_PORT=8765
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/course_kg
ENABLE_DATABASE_FALLBACK=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=
COURSE_NAME=Sample Course
DATA_ROOT=./data
# STORAGE_ROOT=./data/Sample Course/storage
# INGESTION_ROOT=./data/Sample Course/ingestion
OPENAI_API_KEY=
CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_RESOLVE_IP=
EMBEDDING_BASE_URL=
# EMBEDDING_RESOLVE_IP=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
CHAT_MODEL=qwen-plus
EMBEDDING_DIMENSIONS=1024
GRAPH_EXTRACTION_STRATEGY=adaptive_best_first
GRAPH_EXTRACTION_SOFT_START_BUDGET=120
GRAPH_EXTRACTION_MAX_MODEL_CALLS_PER_RUN=800
GRAPH_EXTRACTION_CONCURRENCY=2
WORKER_CONCURRENCY=3
INGESTION_FILE_CONCURRENCY=3
MODEL_REQUEST_CONCURRENCY=3
MODEL_REQUEST_TIMEOUT_SECONDS=240
HPO_CONCURRENCY=1
ENABLE_GRAPH_COMMUNITY_SUMMARIES=true
GRAPH_EXTRACTION_RESUME_BATCH_SIZE=24
ENABLE_MODEL_FALLBACK=false
RERANKER_ENABLED=false
